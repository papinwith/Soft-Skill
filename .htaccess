# Don't let visitors browse folders that have no index.php (e.g. assets/, vendor/).
Options -Indexes

# Basic hardening headers.
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data:; frame-ancestors 'self'; object-src 'none'"
</IfModule>

# Deny direct web access to files that should never be served (DB dumps, seed
# password hashes, local configs, dependency manifests, source control metadata).
<FilesMatch "\.(sql|sql\.gz|md|log|lock|example)$">
    Require all denied
</FilesMatch>

<Files "composer.json">
    Require all denied
</Files>

<Files "Modelfile">
    Require all denied
</Files>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
